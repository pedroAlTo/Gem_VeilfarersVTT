{
  "name": "veilfarers-vtt",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "prebuild": "node scripts/release-notes.mjs --check",
    "release:notes": "node scripts/release-notes.mjs",
    "release:check": "node scripts/release-notes.mjs --check",
    "test:account": "firebase emulators:exec --only firestore --project demo-veilfarers-vtt \"node --test tests/account.integration.js\"",
    "test:rooms": "firebase emulators:exec --only firestore --project demo-veilfarers-vtt \"node --test tests/rooms.integration.js\""
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "dompurify": "^3.4.17",
    "firebase": "^13.1.0",
    "gsap": "^3.15.0",
    "peerjs": "^1.5.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "fake-indexeddb": "^6.2.7",
    "firebase-tools": "^15.35.0",
    "jsdom": "^30.1.3",
    "vite": "^6.1.1"
  }
}
